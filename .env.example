AWS_REGION=us-east-1
USERS_TABLE=ServiceAgentUsers
APPLICATIONS_TABLE=ServiceAgentApplications
EXTRACTED_DOCS_TABLE=ServiceAgentExtractedDocs
AGENT_LOGS_TABLE=ServiceAgentAgentLogs
PLANNER_STATE_TABLE=ServiceAgentPlannerState
AUTOMATION_TIMELINE_TABLE=ServiceAgentAutomationTimeline
S3_BUCKET=serviceagent-storage

# Backward-compatible optional overrides used by backend services.
DOCUMENTS_BUCKET=serviceagent-storage
ARTIFACTS_BUCKET=serviceagent-storage

# Bedrock model IDs
NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0
NOVA_MULTIMODAL_MODEL_ID=amazon.nova-pro-v1:0
NOVA_LITE_MODEL_ID=amazon.nova-lite-v1
NOVA_ACT_MODEL_ID=amazon.nova-act-v1:0

# Runtime flags
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
