# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=

# Storage
DOCUMENTS_BUCKET=serviceagent-docs-dev
ARTIFACTS_BUCKET=service-agent-demo-artifacts

# DynamoDB
USERS_TABLE=ServiceAgentUsers
APPLICATIONS_TABLE=ServiceAgentApplications
EXTRACTED_DOCS_TABLE=ServiceAgentExtractedDocuments
AGENT_LOGS_TABLE=ServiceAgentAgentLogs
PLANNER_STATE_TABLE=ServiceAgentPlannerState
AUTOMATION_TIMELINE_TABLE=ServiceAgentAutomationTimeline

# Bedrock Nova model IDs (set to the IDs available in your account/region)
NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0
NOVA_MULTIMODAL_MODEL_ID=amazon.nova-pro-v1:0
NOVA_LITE_MODEL_ID=amazon.nova-lite-v1:0
NOVA_ACT_MODEL_ID=amazon.nova-act-v1:0

# Notifications
NOTIFICATION_SENDER_EMAIL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Demo
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
